{
  "expo": {
    "name": "LocalLoop",
    "slug": "localloop",
    "scheme": "localloop",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "LocalLoop — good finds, close by"
    },
    "plugins": ["expo-router"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.localloop.demo" },
    "android": { "package": "com.localloop.demo" }
  }
}
